{
  "name": "triseal-ps4-platform",
  "version": "2.4.0",
  "private": true,
  "description": "TriSeal: sealed multi-party red-teaming for AI models — airlock relay, tamper-evident ledger, conformance, side-channel hunting and a signed release gate",
  "scripts": {
    "setup": "npm --prefix site install",
    "dev": "npm --prefix site run dev",
    "build": "npm --prefix site run build",
    "preview": "npm --prefix site run preview",
    "api": "python -m uvicorn api.index:app --reload --port 8000",
    "verify": "python cli/triseal_verify.py --self-test",
    "verify:tamper": "python cli/triseal_verify.py --self-test --simulate-tamper"
  },
  "keywords": [
    "ai-safety",
    "red-teaming",
    "gvisor",
    "merkle-tree",
    "opa",
    "triseal"
  ],
  "author": "Team Pinnacle (Jyotasana, Arpita Matta, Anand Minejes)",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  }
}
