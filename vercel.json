{
  "version": 2,
  "name": "triseal-ps4-platform",
  "cleanUrls": true,
  "buildCommand": "cd site && npm install && npx vite build",
  "outputDirectory": "site/dist",
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.py" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
